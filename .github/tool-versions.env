# Pinned tool versions + SHA256 checksums (linux-amd64).
# mihomo / sing-box releases ship no checksum file, so the hashes below are
# the repo's own pins: the sync workflow verifies every download fail-closed
# (mismatch -> exit 1); update-tool-versions.yml refreshes versions AND
# hashes together. Never bump a version by hand without its hash.
# MIHOMO_SHA256_TGZ may be empty: some releases ship no linux-amd64 .tar.gz
# (e.g. 1.19.33 has only .gz); the updater fills it when a tar.gz exists.
MIHOMO_VERSION=1.19.33
MIHOMO_SHA256_TGZ=
MIHOMO_SHA256_GZ=132f6f3edf9a65e62f04853aed3358472e0b2b7666daa8419edfa2ddf5bb6323
SINGBOX_VERSION=1.14.4
SINGBOX_SHA256=699a1b510aa4396b2176d32d1181920399ebf1e267835da6f3b598d0f7c24968
